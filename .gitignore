# ==============================================================================
# SpinDB .gitignore - Comprehensive Project Exclusion Manifest
# ==============================================================================

# IDE, Editor, and System Artifacts
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Agentic, Assistant & Workspace Metadatas
.agents/
.gemini/
skills/

# Ephemeral Build & Temporary Directories
build/
build.*/
tmp/
*.tmp
*.jar
.cache/
__pycache__/
*.pyc

# JDBC Driver Binaries & Cache (Never Commit Binary JARs)
drivers/*.jar
drivers/*.zip
!drivers/.gitkeep

# Environment Overrides & Secret Credentials (Never Commit Secrets)
*.local.properties
Database.properties.local
config/Database.properties.local
*.env
!config/database.env.example
secrets/
*.pem
*.key
*.crt

# Persistent Database Storage & Data Dumps
data/
pgdata/
mysqldata/
mongodata/
db2data/
redisdata/
clickhousedata/
cockroachdata/
*.mdf
*.ldf
*.dump
*.archive

# Execution & Test Logs
*.log
logs/
test_output.log
/tmp/test_*.log

# Container Runtime Ephemeral Files
.container-id*
.podman*
.docker*
