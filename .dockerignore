# ==============================================================================
# SpinDB .dockerignore - Docker & Podman Build Context Exclusion
# ==============================================================================

# VCS and Configuration
.git/
.gitignore
.dockerignore

# IDE and Editors
.idea/
.vscode/
*.iml
.DS_Store

# Agent and Skill metadata
.agents/
.gemini/
skills/

# Tests and Documentation
tests/
docs/
*.md
Makefile
LICENSE

# Ephemeral and Build directories
build/
build.*/
tmp/
*.tmp
*.log
logs/

# Sensitive Credential Files
Database.properties.local
config/Database.properties.local
*.env
secrets/
*.pem
*.key
